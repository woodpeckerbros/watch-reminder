    <string name="ui_permission_notifications_title">למה צריך אישור להתראות?</string>
    <string name="ui_permission_notifications_message">Zmanio צריכה לשלוח התראות כדי להציג את התזכורות שיצרת בזמן. במסך הבא השעון יבקש ממך לאשר התראות.</string>
    <string name="ui_permission_location_title">למה צריך מיקום?</string>
    <string name="ui_permission_location_message">המיקום משמש לחישוב מדויק של זמני היום והזמנים ההלכתיים באזור שלך. Zmanio אינה משתפת את המיקום. במסך הבא השעון יבקש גישה למיקום.</string>
    <string name="ui_permission_activity_title">למה צריך זיהוי פעילות?</string>
    <string name="ui_permission_activity_message">Zmanio משתמשת בהרשאה הזו כדי לזהות אם המשתמש ישן. כך היא יכולה להימנע מהפעלת התראה בזמן השינה, להמתין ולהציג אותה לאחר ההתעוררות. ההרשאה אינה משמשת לספירת צעדים או למעקב אחר אימונים. במסך הבא השעון יבקש גישה לזיהוי פעילות.</string>
    <string name="ui_permission_sensors_title">למה צריך לזהות את מצב השעון?</string>
    <string name="ui_permission_sensors_message">כדי לא להעיר בזמן שינה ולא להפעיל התראה כשהשעון אינו על היד, Zmanio משתמשת בחיישנים כדי לזהות את המצב הנוכחי. כך אפשר להציג את ההתראה מיד כשמתאים, או להמתין עד שהמשתמש ער והשעון שוב על היד. במסך הבא השעון יבקש גישה לחיישנים.</string>
    <string name="ui_permission_full_screen_title">למה צריך התראות במסך מלא?</string>
    <string name="ui_permission_full_screen_message">האישור מאפשר לתזכורת חשובה להופיע מעל המסך הנוכחי גם כשהשעון נעול. במסך הבא יש לאפשר זאת עבור Zmanio.</string>
    <string name="ui_permission_dnd_title">לאפשר לשעון המעורר לעקוף “נא לא להפריע”?</string>
    <string name="ui_permission_dnd_message">אישור אופציונלי זה מאפשר לערוץ של השעון המעורר החכם לבקש צלצול ורטט גם במצב “נא לא להפריע”. במסך הבא יש לבחור ב־Zmanio ולאשר. מצב השינה והגדרות המערכת עדיין יכולים לחסום את ההתראה.</string>
    <string name="ui_permission_dnd_unavailable">השעון אינו מציג את מסך הגישה ל״נא לא להפריע״.</string>
    <string name="ui_enable_alarms_reminders_title">אישור Alarms &amp; reminders</string>
    <string name="ui_enable_alarms_reminders_message">כדי שהתזכורות יצלצלו בזמן גם כשהשעון במצב חיסכון או המסך כבוי, צריך לאשר לאפליקציה Alarms &amp; reminders. במסך שייפתח חפש Zmanio או Alarms &amp; reminders, פתח את Zmanio והפעל Allow.</string>
    <string name="ui_enable_alarms_reminders_hint">במסך שייפתח צריך להפעיל Alarms &amp; reminders כדי שהתזכורות יפעלו בזמן.</string>
